{
  "name": "dsh-plugin-siyuan",
  "version": "0.1.2",
  "description": "思源完整连接层与五个 DSH 工具：CRUD、原始 HTTP、WS、JSON-RPC 和 MCP",
  "author": "leolee9086",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolee9086/dsh-plugin-siyuan.git"
  },
  "homepage": "https://github.com/leolee9086/dsh-plugin-siyuan#readme",
  "bugs": {
    "url": "https://github.com/leolee9086/dsh-plugin-siyuan/issues"
  },
  "type": "module",
  "license": "AGPL-3.0-only",
  "main": "./lib/host.js",
  "types": "./lib/host.d.ts",
  "exports": {
    ".": { "types": "./lib/host.d.ts", "import": "./lib/host.js" },
    "./connection": { "types": "./lib/connection.d.ts", "import": "./lib/connection.js" },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "scripts",
    "tests",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run build && pnpm test",
    "release:pack": "pnpm run check && pnpm pack --pack-destination releases"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@leolee9086/sac-path-router": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "json-rpc-2.0": "^1.8.1",
    "ws": "^8.22.0"
  }
}
