{
  "name": "dsh-plugin-siyuan",
  "version": "0.5.0",
  "description": "思源连接管理与 DSH 工具箱协同：五个基础工具、697条 HTTP 契约、MCP 工具发现与逐端点授权",
  "author": "leolee9086",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leolee9086/dsh-plugin-siyuan.git"
  },
  "homepage": "https://github.com/leolee9086/dsh-plugin-siyuan#readme",
  "bugs": {
    "url": "https://github.com/leolee9086/dsh-plugin-siyuan/issues"
  },
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "main": "./lib/host.js",
  "types": "./lib/host.d.ts",
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "import": "./lib/host.js"
    },
    "./connection": {
      "types": "./lib/connection.d.ts",
      "import": "./lib/connection.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets",
    "NOTICE",
    "src",
    "scripts",
    "tests",
    "tsconfig.json",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "pnpm run test:behavior && pnpm run test:protocol",
    "test:behavior": "node --test tests/behavior/*.test.mjs",
    "test:protocol": "node --test tests/*.test.mjs",
    "check": "pnpm run build && pnpm test",
    "release:pack": "pnpm run check && pnpm pack --pack-destination releases"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "jsdom": "^30.1.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "react"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@leolee9086/sac-path-router": "^0.2.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ajv": "^8.20.0",
    "json-rpc-2.0": "^1.8.1",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  }
}
